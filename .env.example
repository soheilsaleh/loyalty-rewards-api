APP_NAME="Loyalty & Rewards API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Points awarded per whole unit of currency spent (10 points per 1.00 means a
# rate of 10; 1 point per 10 cents).
LOYALTY_EARN_RATE=10

# Points expire this many months after they are earned (FIFO consumption).
LOYALTY_EXPIRY_MONTHS=12

# Members are reminded this many days before a batch of points expires.
LOYALTY_EXPIRY_REMINDER_DAYS=14

# Display currency code.
LOYALTY_CURRENCY=EUR

# Shared secret used to verify inbound webhook signatures (HMAC-SHA256).
LOYALTY_WEBHOOK_SECRET=

# Reject webhook requests whose timestamp is older/newer than this many seconds.
LOYALTY_WEBHOOK_TOLERANCE=300

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=loyalty
DB_USERNAME=loyalty
DB_PASSWORD=secret

# Host port that is forwarded to the MySQL container (3306 inside the network).
FORWARD_DB_PORT=3307

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=loyalty

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@loyalty.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025

APP_PORT=8000
